{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Django Backend",
      "type": "shell",
      "command": "python manage.py runserver 127.0.0.1:8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "dev-servers"
      }
    },
    {
      "label": "Start Vite Frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "group": "dev-servers"
      }
    },
    {
      "label": "Start Full Stack",
      "dependsOn": [
        "Start Django Backend",
        "Start Vite Frontend"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}